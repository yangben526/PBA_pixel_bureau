/**
 * 0..1 draw strength for one LED at [nowMs].
 * Dots hard-blink (~55% duty) with per-LED phase/period.
 */
fun serverLedStrength(led: ServerLed, nowMs: Long): Float {
    val period = led.periodMs.coerceAtLeast(1)
    val t = ((nowMs % period).toFloat() / period + led.phase).mod(1f)
    // Async blink — on most of the cycle, short dark gap.
    return if (t < 0.55f || t > 0.78f) 1f else 0.08f
}
