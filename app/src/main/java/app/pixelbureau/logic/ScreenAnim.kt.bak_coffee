package app.pixelbureau.logic

/**
 * One terminal segment on a laptop screen overlay.
 * [row] is 0..(rowCount-1) from top of the glass; [start]/[end] are
 * 0..1 across that row; [bright] picks the lit vs dim glyph color;
 * [prompt] marks the left-edge `$` / `>` stub so rows read as a shell.
 */
data class ScreenGlyph(
    val row: Int,
    val start: Float,
    val end: Float,
    val bright: Boolean,
    val prompt: Boolean = false,
)

/**
 * Desk indices whose laptop screens should animate, mapped to the typing
 * agent's animation frame. Only [ActorSnap.anim] == "type" counts — idle sit
 * ("done"), empty desks, and walkers leave the wallpaper alone.
 */
fun desksWithActiveScreens(actors: List<ActorSnap>): Map<Int, Int> {
    val lit = LinkedHashMap<Int, Int>()
    for (actor in actors) {
        val desk = actor.deskIndex ?: continue
        if (actor.anim == "type") {
            lit[desk] = actor.frame
        }
    }
    return lit
}

/**
 * Terminal-typing pattern for one animation frame. Deterministic, no
 * allocations beyond the returned list — safe to call every draw.
 *
 * Rows above the active line stay full (already typed). The active line
 * grows left→right with the frame. A short prompt stub leads each row.
 */
fun screenCodeGlyphs(frame: Int, rows: Int = 6): List<ScreenGlyph> {
    val phase = frame.mod(12)
    val activeRow = phase.mod(rows)
    val typeProgress = ((phase % 4) + 1) / 4f
    val glyphs = ArrayList<ScreenGlyph>(rows * 3)
    for (row in 0 until rows) {
        val seed = (row * 5 + (frame / 12) * 3).mod(11)
        val indent = 0.10f + (seed % 3) * 0.04f
        val fullLen = 0.22f + (seed % 5) * 0.10f
        // Prompt stub (`$` / `>`) on every row.
        glyphs.add(ScreenGlyph(row, 0.04f, 0.09f, bright = true, prompt = true))
        val progress = when {
            row < activeRow -> 1f
            row == activeRow -> typeProgress
            else -> 0f
        }
        if (progress <= 0.02f) continue
        val start = indent
        val end = (start + fullLen * progress).coerceAtMost(0.92f)
        glyphs.add(
            ScreenGlyph(
                row,
                start,
                end,
                bright = row == activeRow || (row + phase).mod(3) != 0,
            ),
        )
        // Extra token on completed lines (reads as `cmd --flag`).
        if (progress >= 0.99f && seed >= 4 && end < 0.72f) {
            val s2 = (end + 0.05f).coerceAtMost(0.82f)
            val e2 = (s2 + 0.10f + (seed % 3) * 0.06f).coerceAtMost(0.94f)
            if (e2 > s2 + 0.04f) {
                glyphs.add(ScreenGlyph(row, s2, e2, bright = false))
            }
        }
    }
    return glyphs
}

/** True on even blink ticks — draw a block cursor after the active line. */
fun screenCursorVisible(frame: Int): Boolean = (frame / 2).mod(2) == 0

/** Row index (0-based) that currently has the typing caret. */
fun screenCursorRow(frame: Int, rows: Int = 6): Int = frame.mod(12).mod(rows)

/** 0..1 caret column along the active row (just past typed text). */
fun screenCursorCol(frame: Int, rows: Int = 6): Float {
    val phase = frame.mod(12)
    val activeRow = phase.mod(rows)
    val typeProgress = ((phase % 4) + 1) / 4f
    val seed = (activeRow * 5 + (frame / 12) * 3).mod(11)
    val indent = 0.10f + (seed % 3) * 0.04f
    val fullLen = 0.22f + (seed % 5) * 0.10f
    return (indent + fullLen * typeProgress).coerceAtMost(0.92f)
}

/**
 * One LED region on the cropped server sprite (fractions of keyAndCrop bounds).
 * Dots blink on/off. [green] picks phosphor tint (else amber).
 * [phase] 0..1 offsets the blink so neighbors stay asynchronous.
 * [periodMs] full cycle length for that element.
 * [bar] retained for API stability; long glow bars were removed — all entries are dots.
 */
data class ServerLed(
    val left: Float,
    val top: Float,
    val right: Float,
    val bottom: Float,
    val green: Boolean,
    val bar: Boolean,
    val phase: Float,
    val periodMs: Int,
)

